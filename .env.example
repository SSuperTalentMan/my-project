# ============================================================
# 「商枢」CommercePivot — 环境变量模板
# 复制为 .env 后按需修改；.env 已被 .gitignore 忽略。
#
# 【安全约定】真实 API Key 只写在控制台环境变量里，
# .env 中保持占位符 sk-your-dashscope-api-key，禁止提交真实密钥。
# ============================================================

# ========== 大模型 API（阿里云百炼，OpenAI 兼容模式）==========
API_KEY=sk-your-dashscope-api-key
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 默认与架构文档 §3.6 一致：qwen3.7-flash（百炼真实可用，实测 http=200）
# 其他候选（qwen-flash/qwen-plus/qwen3-max/qwen-max/qwen-turbo）当前账号下 403 免费额度耗尽
LLM_MODEL=qwen3.7-flash
# 混合推理模型（如 qwen3.7-flash）默认输出思维链：慢且同样计费。
# 本项目只需把查询结果改写成话术，关闭即可（实测 12.7s→5.3s、额度省 2.8 倍）。
LLM_ENABLE_THINKING=false
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_S=60
LLM_MAX_RETRIES=2

# ========== MySQL（小皮面板 / phpStudy）==========
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DB=commercepivot
MYSQL_POOL_SIZE=8
MYSQL_CONNECT_TIMEOUT=5

# ========== Redis（Docker）==========
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=1234
REDIS_DB=0

# ========== Milvus ==========
# 默认：Milvus Lite 本地内嵌（纯 Python 实现，Windows / macOS / Linux 通用）
# 前置条件：pymilvus>=2.6.4 + milvus-lite>=3.0（proto 需含 shards_num 字段）
MILVUS_URI=./data/milvus/commercepivot.db
# 备选：Docker 版 Milvus Standalone（数据量大或需要多进程共享时）
#   docker compose --profile milvus up -d
# MILVUS_URI=http://localhost:19530
# 远程连接的建立超时；调小可让「服务没起」快速降级而不是干等
MILVUS_CONNECT_TIMEOUT_S=3
MILVUS_COLLECTION_PRODUCT=product_kb
MILVUS_COLLECTION_FAQ=faq_kb
MILVUS_DENSE_DIM=1024
RETRIEVAL_TOP_K=10
RERANK_TOP_K=3

# ========== 本地模型（留空则自动降级：意图走规则、向量走哈希）==========
# 例：INTENT_BERT_PATH=./models/intent-bert
INTENT_BERT_PATH=
INTENT_CONFIDENCE_THRESHOLD=0.55
# 例：BGE_M3_PATH=./models/bge-m3
BGE_M3_PATH=
# 例：RERANKER_PATH=./models/bge-reranker-v2-m3
RERANKER_PATH=
# 允许从 HuggingFace 自动下载权重（默认关闭，离线环境保持 false）
MODEL_AUTODOWNLOAD=false
# 国内可用的 HF 镜像
HF_ENDPOINT=https://hf-mirror.com

# ========== 服务端口 ==========
HOST=0.0.0.0
API_PORT=8000
MCP_PORT=8001
A2A_PORT_BASE=8002
DEBUG=true
CORS_ORIGINS=*

# ========== 安全 ==========
# 生产环境务必替换为强随机串
JWT_SECRET=commercepivot-dev-secret-change-me
JWT_EXPIRE_MINUTES=720
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=120
# 写操作总开关：默认 false（只读），开启后 create_ticket 等写工具才可用
ENABLE_WRITE_OPS=false

# ========== 链路与熔断 ==========
MCP_TOOL_TIMEOUT_S=10
MCP_TOOL_RETRIES=1
# local=进程内直调（默认）；http=走独立 MCP Server :8001
MCP_TRANSPORT=local
A2A_TIMEOUT_S=15
A2A_CIRCUIT_FAIL_THRESHOLD=3
A2A_CIRCUIT_RESET_S=30
CACHE_TTL_S=300

# ========== 日志与审计 ==========
LOG_LEVEL=INFO
LOG_JSON=false
# 日志输出流：stdout（默认，长驻服务）| stderr
# stdio 传输下 stdout 是 JSON-RPC 专用通道，stdio_server 会强制切到 stderr；
# 若宿主自行拉起本进程且你把它写成了 stdout，宿主会因解析到非 JSON 内容而握手失败。
LOG_STREAM=stdout
AUDIT_LOG_PATH=logs/mcp_audit.jsonl
